// CSS MPT Prep — Prisma schema
//
// DB: PostgreSQL (works locally and on serverless hosts like Vercel).
//   - `options` / `answers` use `Json`.
//   - `role` / `difficulty` / `kind` are stored as `String`.
// Use a free Postgres from Neon (neon.tech) or Supabase. Set DATABASE_URL to the
// connection string, then `npm run db:push && npm run db:seed`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  name               String
  passwordHash       String
  mustChangePassword Boolean   @default(true)
  isActive           Boolean   @default(true)
  role               String    @default("STUDENT") // STUDENT | ADMIN
  createdAt          DateTime  @default(now())
  attempts           Attempt[]
}

/// One of the seven MPT subjects. `mptMarks` is the official FPSC weighting
/// (English 50, GSA 60, Pakistan Affairs 20, Current Affairs 20, Islamic
/// Studies 20, Urdu 20, General Knowledge 10 — 200 in total).
model Subject {
  id          String  @id @default(cuid())
  slug        String  @unique
  title       String
  description String
  order       Int     @default(0)
  mptMarks    Int     @default(0)
  tests       Test[]
}

/// A sittable paper. `kind` decides how it behaves in the UI:
///   PRACTICE   — subject test (subjectId set)
///   DRILL      — short topic drill (subjectId set, topic set)
///   MOCK       — full 200-question MPT simulation (subjectId null)
///   PAST_PAPER — recalled FPSC paper (subjectId null, paperYear set)
model Test {
  id          String     @id @default(cuid())
  key         String     @unique // stable seed key, e.g. "english-3", "mock-2", "paper-mpt-2026"
  subjectId   String?
  subject     Subject?   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  kind        String     @default("PRACTICE")
  topic       String?
  number      Int // contiguous within its kind / subject
  title       String
  difficulty  String     @default("MEDIUM") // EASY | MEDIUM | HARD
  durationMin Int        @default(30)
  paperYear   Int?
  isPublished Boolean    @default(true)
  createdAt   DateTime   @default(now())
  questions   Question[]
  attempts    Attempt[]

  @@index([subjectId, number])
  @@index([kind])
}

model Question {
  id           String @id @default(cuid())
  testId       String
  test         Test   @relation(fields: [testId], references: [id], onDelete: Cascade)
  order        Int
  text         String
  options      Json // string[] — exactly 4 options
  correctIndex Int // 0..3
  explanation  String
  /// Subject this question belongs to, even inside a mixed mock or past paper.
  subjectSlug  String?
  /// Fine-grained topic (e.g. "number-series", "seerah") — powers weak-area drills.
  topic        String?

  @@index([testId])
  @@index([subjectSlug])
}

model Attempt {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  testId      String
  test        Test      @relation(fields: [testId], references: [id], onDelete: Cascade)
  answers     Json // [{ questionId, selectedIndex | null, markedForReview }]
  score       Int
  total       Int
  accuracy    Float
  startedAt   DateTime
  submittedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([testId])
  @@index([userId, submittedAt])
}
