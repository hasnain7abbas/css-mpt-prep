# Copy to .env and fill in. .env is gitignored.

# PostgreSQL. Get a free database from Neon (neon.tech) or Supabase and paste
# its connection string here. Then run `npm run db:push && npm run db:seed`.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Owner WhatsApp number for manual registration (no '+', wa.me format)
NEXT_PUBLIC_OWNER_WHATSAPP="923415298183"
